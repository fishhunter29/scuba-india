# ---------------------------------------------------------------------------
# Scuba India — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Used by the seed script / admin storage ops.
# Never expose to the browser. (Project Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public site URL (used for canonical URLs, sitemap, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://scubaindia.in

# Analytics & conversion tracking (optional — leave blank to disable). SPEC §5.4
# Each fires only when set. Conversion events (whatsapp_click / call_click /
# book_click) are emitted automatically on the relevant CTAs.
NEXT_PUBLIC_GA4_ID=               # GA4 measurement id, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=        # Meta (Facebook) pixel id

# Google Ads conversion tracking.
# GOOGLE_ADS_ID:    Ads tag id, e.g. AW-1234567890 (Tools → Data manager / Tags).
# GOOGLE_ADS_LABEL: conversion label from the conversion action you create
#                   (the "send_to" value is AW-...../LABEL). Used for the lead
#                   conversion fired on WhatsApp / call / book clicks.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL=

# Live Google reviews via Places API (server-only; optional).
# Leave blank to fall back to admin-managed reviews in the DB.
# GOOGLE_MAPS_API_KEY: Google Cloud → enable "Places API (New)" → create an API key.
# GOOGLE_PLACE_ID: your listing's Place ID (find via Google's Place ID Finder).
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
